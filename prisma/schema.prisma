// ══════════════════════════════════════════
// NEXORA — Schema Prisma
// Fase 1: Fundación e Infraestructura Base
// ══════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────

enum Rol {
  ROL_ADMIN
  ROL_VENDEDOR
  ROL_BODEGUERO
}

enum SeasonTipo {
  INICIO_CLASES
  NAVIDAD
  FIESTAS_LOCALES
  OTRA
}

// ──────────────────────────────────────────
// AUTH — Usuarios y Tokens
// ──────────────────────────────────────────

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  nombre         String
  rol            Rol
  activo         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ──────────────────────────────────────────
// CONFIGURACIÓN DEL NEGOCIO
// ──────────────────────────────────────────

model BusinessConfig {
  id        String   @id @default(uuid())
  nombre    String
  ruc       String   // Cifrado con AES-256-GCM en capa de infraestructura
  direccion String
  telefono  String?
  email     String?
  logoUrl   String?
  updatedAt DateTime @updatedAt

  @@map("business_config")
}

// ──────────────────────────────────────────
// TEMPORADAS
// ──────────────────────────────────────────

model Season {
  id          String     @id @default(uuid())
  nombre      String
  tipo        SeasonTipo
  fechaInicio DateTime
  fechaFin    DateTime
  activa      Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@map("seasons")
}

// ──────────────────────────────────────────
// SERIES Y TALLAS DE CALZADO
// ──────────────────────────────────────────

model SeriesConfig {
  id       String        @id @default(uuid())
  nombre   String        @unique // BEBE, NINO_PEQUENO_A, NINO_PEQUENO_B, NINO, JUVENIL, ADULTO, TALLA_GRANDE
  activa   Boolean       @default(true)
  tallas   TallaConfig[]
  products Product[]

  @@map("series_config")
}

model TallaConfig {
  id           String         @id @default(uuid())
  numero       Int
  serieId      String
  serie        SeriesConfig   @relation(fields: [serieId], references: [id], onDelete: Cascade)
  stockByTalla StockByTalla[]

  @@map("talla_config")
}

// ──────────────────────────────────────────
// INVENTARIO — Productos y Stock (Fase 2)
// ──────────────────────────────────────────

model Product {
  id                String             @id @default(uuid())
  codigo            String             @unique
  nombre            String
  marca             String
  modelo            String
  material          String?
  fotoUrl           String?
  precioCosto       Decimal            @db.Decimal(10, 2)
  precioVenta       Decimal            @db.Decimal(10, 2)
  serieId           String
  serie             SeriesConfig       @relation(fields: [serieId], references: [id])
  activo            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  stockByTalla      StockByTalla[]
  stockReservations StockReservation[]
  stockMovements    StockMovement[]
  priceHistory      PriceHistory[]

  @@map("products")
}

model StockByTalla {
  id                String      @id @default(uuid())
  productId         String
  tallaId           String
  cantidad          Int         @default(0) // stock físico real
  cantidadReservada Int         @default(0) // suma de reservas activas
  stockMinimo       Int         @default(0)
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  talla             TallaConfig @relation(fields: [tallaId], references: [id], onDelete: Cascade)

  @@unique([productId, tallaId])
  @@map("stock_by_talla")
}

model StockReservation {
  id          String   @id @default(uuid())
  productId   String
  tallaId     String
  cantidad    Int
  motivo      String   // "PEDIDO", "MUESTRA", "ANTICIPO"
  referenceId String?  // ID de referencia (pedidoId, etc.)
  expiresAt   DateTime
  cancelada   Boolean  @default(false)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_reservations")
}

model StockMovement {
  id          String         @id @default(uuid())
  productId   String
  tallaId     String
  tipo        MovimientoTipo
  cantidad    Int            // Positivo = entrada, Negativo = salida
  motivo      String
  referenceId String?
  userId      String
  createdAt   DateTime       @default(now())
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}

enum MovimientoTipo {
  ENTRADA_MERCANCIA
  VENTA
  DEVOLUCION_CLIENTE
  DEVOLUCION_PROVEEDOR
  BAJA
  AJUSTE
  RESERVA
  LIBERACION_RESERVA
}

model PriceHistory {
  id                  String   @id @default(uuid())
  productId           String
  precioCostoAnterior Decimal  @db.Decimal(10, 2)
  precioVentaAnterior Decimal  @db.Decimal(10, 2)
  precioCostoNuevo    Decimal  @db.Decimal(10, 2)
  precioVentaNuevo    Decimal  @db.Decimal(10, 2)
  cambiadoPorId       String
  motivo              String?
  createdAt           DateTime @default(now())
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("price_history")
}

