// ══════════════════════════════════════════
// NEXORA — Schema Prisma
// Fase 1: Fundación e Infraestructura Base
// ══════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────

enum Rol {
  ROL_SUPER_ADMIN
  ROL_ADMIN
  ROL_VENDEDOR
  ROL_BODEGUERO
}

enum SeasonTipo {
  INICIO_CLASES
  NAVIDAD
  FIESTAS_LOCALES
  OTRA
}

// ──────────────────────────────────────────
// SAAS — Tenants
// ──────────────────────────────────────────

model Tenant {
  id             String           @id @default(uuid())
  name           String
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  users          User[]
  businessConfig BusinessConfig?
  productModels  ProductModel[]
  clients        Client[]
  orders         Order[]
  suppliers      Supplier[]
  seasons        Season[]
  saleNotes      SaleNote[]
  cobros         Cobro[]
  deudas         DeudaProveedor[]
  clienteDevoluciones ClienteDevolucion[]
  proveedorDevoluciones ProveedorDevolucion[]
  facturasElectronicas FacturaElectronica[]
  cierresCaja    CierreCaja[]

  @@map("tenants")
}

// ──────────────────────────────────────────
// AUTH — Usuarios y Tokens
// ──────────────────────────────────────────

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  nombre         String
  rol            Rol
  activo         Boolean         @default(true)
  permiteCambiarPrecio Boolean   @default(false)
  tenantId       String?
  parentId       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  parent         User?           @relation("UserHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       User[]          @relation("UserHierarchy")
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ──────────────────────────────────────────
// CONFIGURACIÓN DEL NEGOCIO
// ──────────────────────────────────────────

model BusinessConfig {
  id                    String   @id @default(uuid())
  tenantId              String   @unique
  nombre                String
  ruc                   String   // Cifrado con AES-256-GCM en capa de infraestructura
  direccion             String
  telefono              String?
  email                 String?
  logoUrl               String?
  // Configuración Facturación Electrónica SRI (Fase 12)
  firmaP12Path          String?
  firmaPasswordEnc      String?  // Contraseña .p12 cifrada con AES-256
  sriAmbiente           String   @default("1") // "1": Pruebas, "2": Producción
  sriEstablecimiento    String   @default("001")
  sriPuntoEmision       String   @default("001")
  sriObligadoContabilidad Boolean @default(false)

  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("business_config")
}

// ──────────────────────────────────────────
// TEMPORADAS
// ──────────────────────────────────────────

model Season {
  id          String     @id @default(uuid())
  tenantId    String
  nombre      String
  tipo        SeasonTipo
  fechaInicio DateTime
  fechaFin    DateTime
  activa      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("seasons")
}

// ──────────────────────────────────────────
// SERIES Y TALLAS DE CALZADO
// ──────────────────────────────────────────

model SeriesConfig {
  id       String        @id @default(uuid())
  nombre   String        @unique // BEBE, NINO_PEQUENO_A, NINO_PEQUENO_B, NINO, JUVENIL, ADULTO, TALLA_GRANDE
  activa   Boolean       @default(true)
  tallas   TallaConfig[]
  products Product[]

  @@map("series_config")
}

model TallaConfig {
  id           String         @id @default(uuid())
  numero       Int
  serieId      String
  serie        SeriesConfig   @relation(fields: [serieId], references: [id], onDelete: Cascade)
  stockByTalla StockByTalla[]

  @@map("talla_config")
}

// ──────────────────────────────────────────
// INVENTARIO — Productos y Stock (Fase 2)
// ──────────────────────────────────────────

model ProductModel {
  id        String    @id @default(uuid())
  tenantId  String
  baseCode  String    @unique
  name      String
  brand     String
  material  String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("product_models")
}

model Product {
  id                String             @id @default(uuid())
  modelId           String
  model             ProductModel       @relation(fields: [modelId], references: [id], onDelete: Cascade)
  code              String             @unique
  color             String
  imageUrl          String?
  costPrice         Decimal            @db.Decimal(10, 2)
  salePrice         Decimal            @db.Decimal(10, 2)
  serieId           String
  serie             SeriesConfig       @relation(fields: [serieId], references: [id])
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  stockByTalla      StockByTalla[]
  stockReservations StockReservation[]
  stockMovements    StockMovement[]
  priceHistory      PriceHistory[]

  @@map("products")
}

model StockByTalla {
  id               String      @id @default(uuid())
  productId        String
  tallaId          String
  quantity         Int         @default(0) // stock físico real
  reservedQuantity Int         @default(0) // suma de reservas activas
  minStock         Int         @default(0)
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  talla            TallaConfig @relation(fields: [tallaId], references: [id], onDelete: Cascade)

  @@unique([productId, tallaId])
  @@map("stock_by_talla")
}

model StockReservation {
  id          String   @id @default(uuid())
  productId   String
  tallaId     String
  quantity    Int
  reason      String   // "PEDIDO", "MUESTRA", "ANTICIPO"
  referenceId String?  // ID de referencia (pedidoId, etc.)
  expiresAt   DateTime
  canceled    Boolean  @default(false)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_reservations")
}

model StockMovement {
  id          String         @id @default(uuid())
  productId   String
  tallaId     String
  type        MovimientoTipo
  quantity    Int            // Positivo = entrada, Negativo = salida
  reason      String
  referenceId String?
  userId      String
  createdAt   DateTime       @default(now())
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}

enum MovimientoTipo {
  ENTRADA_MERCANCIA
  VENTA
  DEVOLUCION_CLIENTE
  DEVOLUCION_PROVEEDOR
  BAJA
  AJUSTE
  RESERVA
  LIBERACION_RESERVA
}

model PriceHistory {
  id                String   @id @default(uuid())
  productId         String
  previousCostPrice Decimal  @db.Decimal(10, 2)
  previousSalePrice Decimal  @db.Decimal(10, 2)
  newCostPrice      Decimal  @db.Decimal(10, 2)
  newSalePrice      Decimal  @db.Decimal(10, 2)
  changedById       String
  reason            String?
  createdAt         DateTime @default(now())
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("price_history")
}

// ──────────────────────────────────────────
// CLIENTES Y SCORING CREDITICIO (Fase 3)
// ──────────────────────────────────────────

enum NivelCredito {
  SIN_CREDITO
  NIVEL_1
  NIVEL_2
  NIVEL_3
  NIVEL_4
}

model Client {
  id                 String               @id @default(uuid())
  tenantId           String
  nombre             String
  apellido           String
  telefono           String
  email              String?
  ruc                String?              // Cifrado con AES-256-GCM
  cedula             String?              // Cifrado con AES-256-GCM
  direccion          String?
  notas              String?
  nivelCredito       NivelCredito         @default(SIN_CREDITO)
  totalCompras       Int                  @default(0)  // Contador de compras de contado + crédito completadas
  comprasSinAtraso   Int                  @default(0)  // Racha actual de pagos a tiempo
  atrasoConsecutivo  Int                  @default(0)  // Atrasos consecutivos sin saldar
  limiteCredito      Decimal              @db.Decimal(10, 2) @default(0)
  creditoUtilizado   Decimal              @db.Decimal(10, 2) @default(0)
  activo             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  creditScoreHistory CreditScoreHistory[]
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("clients")
}

model CreditScoreHistory {
  id            String       @id @default(uuid())
  clientId      String
  nivelAnterior NivelCredito
  nivelNuevo    NivelCredito
  motivo        String       // "COMPRA_COMPLETADA" | "ATRASO" | "AJUSTE_MANUAL" | "DOS_ATRASOS_CONSECUTIVOS"
  ajustadoPorId String?      // ID del administrador si es AJUSTE_MANUAL
  createdAt     DateTime     @default(now())
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("credit_score_history")
}

model CreditLevelConfig {
  id                String       @id @default(uuid())
  nivel             NivelCredito @unique
  comprasRequeridas Int
  limiteDolares     Decimal      @db.Decimal(10, 2)
  plazoDias         Int
  updatedAt         DateTime     @updatedAt

  @@map("credit_level_config")
}

// ──────────────────────────────────────────
// COMERCIAL — Pedidos y Cola de Prioridad (Fase 4A)
// ──────────────────────────────────────────

enum EstadoPedido {
  EN_ESPERA_STOCK
  PENDIENTE
  EN_PREPARACION
  EN_TRANSITO
  MODIFICADO
  CANCELADO
  ENTREGADO
}

enum CanalEntrada {
  MANUAL
  WHATSAPP
  CATALOGO
}

enum TipoPago {
  CONTADO
  CREDITO
}

enum TipoVenta {
  SERIE_COMPLETA
  TALLA_ESPECIFICA
}

model Order {
  id            String         @id @default(uuid())
  tenantId      String
  clientId      String
  estado        EstadoPedido   @default(PENDIENTE)
  canal         CanalEntrada
  tipoPago      TipoPago
  montoTotal    Decimal        @db.Decimal(10, 2)
  notas         String?
  userId        String         // quién creó el pedido
  lines         OrderLine[]
  queueEntry    OrderQueue?
  dispatchOrder DispatchOrder?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("orders")
}

model OrderLine {
  id             String    @id @default(uuid())
  orderId        String
  productId      String
  serieId        String
  tallaId        String
  cantidad       Int
  precioUnitario Decimal   @db.Decimal(10, 2)
  tipoVenta      TipoVenta
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_lines")
}

model OrderQueue {
  id             String       @id @default(uuid())
  orderId        String       @unique
  clientId       String
  prioridadFifo  DateTime     // timestamp de creación del pedido original
  nivelCredito   NivelCredito
  totalHistorico Decimal      @db.Decimal(10, 2) // total histórico de compras del cliente
  activa         Boolean      @default(true)
  activadaAt     DateTime?
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@map("order_queues")
}

enum DispatchEstado {
  PENDIENTE_SEPARACION
  SEPARADO
  EN_TRANSITO
}

model DispatchOrder {
  id              String              @id @default(uuid())
  orderId         String              @unique
  estado          DispatchEstado      @default(PENDIENTE_SEPARACION)
  lines           DispatchOrderLine[]
  confirmadoPorId String?
  confirmadoAt    DateTime?
  createdAt       DateTime            @default(now())
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("dispatch_orders")
}

model DispatchOrderLine {
  id         String        @id @default(uuid())
  dispatchId String
  productId  String
  serieId    String
  tallaId    String
  cantidad   Int
  aceptada   Boolean       @default(true) // false si el cliente rechazó en entrega
  dispatch   DispatchOrder @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@map("dispatch_order_lines")
}

model OrderModification {
  id               String   @id @default(uuid())
  orderId          String
  tipoModificacion String   // "RECHAZO_PARCIAL" | "CANCELACION_TOTAL"
  montoOriginal    Decimal  @db.Decimal(10, 2)
  montoNuevo       Decimal  @db.Decimal(10, 2)
  lineasRechazadas Json     // array de { productId, tallaId, cantidad }
  userId           String
  createdAt        DateTime @default(now())

  @@map("order_modifications")
}

// ══════════════════════════════════════════
// FASE 5 — NOTAS DE VENTA + BC FINANCIERO
// ══════════════════════════════════════════

model SaleNote {
  id        String         @id @default(uuid())
  tenantId  String
  numero    Int            @unique @default(autoincrement())
  orderId   String
  clientId  String
  lines     SaleNoteLine[]
  subtotal  Decimal        @db.Decimal(10, 2)
  descuento Decimal        @db.Decimal(10, 2) @default(0)
  total     Decimal        @db.Decimal(10, 2)
  pdfUrl    String?
  enviada   Boolean        @default(false)
  cobro     Cobro?
  createdAt DateTime       @default(now())
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("sale_notes")
}

model SaleNoteLine {
  id             String   @id @default(uuid())
  saleNoteId     String
  productId      String
  nombre         String
  serie          String
  talla          String
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  saleNote       SaleNote @relation(fields: [saleNoteId], references: [id], onDelete: Cascade)

  @@map("sale_note_lines")
}

enum TipoCobro {
  CONTADO
  CREDITO
}

enum CobroEstado {
  PENDIENTE
  PARCIALMENTE_PAGADO
  SALDADO
}

model Cobro {
  id               String      @id @default(uuid())
  tenantId         String
  saleNoteId       String      @unique
  clientId         String
  tipo             TipoCobro
  montoTotal       Decimal     @db.Decimal(10, 2)
  saldoPendiente   Decimal     @db.Decimal(10, 2)
  fechaVencimiento DateTime?
  estado           CobroEstado @default(PENDIENTE)
  abonos           CobroAbono[]
  saleNote         SaleNote    @relation(fields: [saleNoteId], references: [id], onDelete: Cascade)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("cobros")
}

model CobroAbono {
  id        String   @id @default(uuid())
  cobroId   String
  monto     Decimal  @db.Decimal(10, 2)
  metodo    String   // "EFECTIVO" | "TRANSFERENCIA" | "CHEQUE"
  notas     String?
  userId    String
  cobro     Cobro    @relation(fields: [cobroId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("cobro_abonos")
}

enum DeudaEstado {
  PENDIENTE
  PARCIALMENTE_PAGADO
  SALDADO
}

model DeudaProveedor {
  id               String      @id @default(uuid())
  tenantId         String
  supplierId       String      // FK a Supplier (se agrega en Fase 6A)
  entradaId        String      @unique // merchandise_entry_id
  montoTotal       Decimal     @db.Decimal(10, 2)
  saldoPendiente   Decimal     @db.Decimal(10, 2)
  fechaVencimiento DateTime
  estado           DeudaEstado @default(PENDIENTE)
  pagos            DeudaPago[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("deudas_proveedor")
}

model DeudaPago {
  id        String         @id @default(uuid())
  deudaId   String
  monto     Decimal        @db.Decimal(10, 2)
  metodo    String
  notas     String?
  userId    String
  deuda     DeudaProveedor @relation(fields: [deudaId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@map("deuda_pagos")
}

// ══════════════════════════════════════════
// FASE 6A — PROVEEDORES E INGRESO MERCANCÍA
// ══════════════════════════════════════════

enum SupplierOrderStatus {
  PENDIENTE
  RECIBIDA
  CANCELADA
}

model Supplier {
  id          String             @id @default(uuid())
  tenantId    String
  ruc         String             @unique // Cifrado AES-256-GCM en infraestructura
  razonSocial String
  contacto    String?
  direccion   String?
  email       String?
  activo      Boolean            @default(true)
  orders      SupplierOrder[]
  entries     MerchandiseEntry[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("suppliers")
}

model SupplierOrder {
  id         String              @id @default(uuid())
  numero     Int                 @unique @default(autoincrement())
  supplierId String
  total      Decimal             @db.Decimal(10, 2)
  estado     SupplierOrderStatus @default(PENDIENTE)
  lines      SupplierOrderLine[]
  entry      MerchandiseEntry?
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@map("supplier_orders")
}

model SupplierOrderLine {
  id              String        @id @default(uuid())
  supplierOrderId String
  productId       String
  cantidadPedida  Int
  precioCosto     Decimal       @db.Decimal(10, 2)
  subtotal        Decimal       @db.Decimal(10, 2)
  order           SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)

  @@map("supplier_order_lines")
}

model MerchandiseEntry {
  id              String                 @id @default(uuid())
  numero          Int                    @unique @default(autoincrement())
  supplierOrderId String?                @unique
  supplierId      String
  total           Decimal                @db.Decimal(10, 2)
  fechaIngreso    DateTime               @default(now())
  lines           MerchandiseEntryLine[]
  supplierOrder   SupplierOrder?         @relation(fields: [supplierOrderId], references: [id])
  supplier        Supplier               @relation(fields: [supplierId], references: [id])
  createdAt       DateTime               @default(now())

  @@map("merchandise_entries")
}

model MerchandiseEntryLine {
  id                 String           @id @default(uuid())
  merchandiseEntryId String
  productId          String
  tallaId            String
  cantidadIngresada  Int
  precioCosto        Decimal          @db.Decimal(10, 2)
  subtotal           Decimal          @db.Decimal(10, 2)
  entry              MerchandiseEntry @relation(fields: [merchandiseEntryId], references: [id], onDelete: Cascade)

  @@map("merchandise_entry_lines")
}

// ──────────────────────────────────────────
// FASE 7 — NOTIFICACIONES
// ──────────────────────────────────────────

model NotificationLog {
  id            String   @id @default(uuid())
  canal         String   // EMAIL | WHATSAPP
  destinatario  String
  asunto        String
  eventoOrigen  String
  estado        String   @default("ENVIADO") // ENVIADO | FALLIDO
  error         String?
  createdAt     DateTime @default(now())

  @@map("notification_logs")
}

// ──────────────────────────────────────────
// FASE 11B — DEVOLUCIONES (CLIENTE Y PROVEEDOR)
// ──────────────────────────────────────────

model ClienteDevolucion {
  id             String                   @id @default(uuid())
  tenantId       String
  saleNoteId     String?
  orderId        String?
  clientId       String
  motivo         String
  totalDevuelto  Decimal                  @db.Decimal(10, 2)
  estado         String                   @default("COMPLETADO") // COMPLETADO | RECHAZADO
  lines          ClienteDevolucionLinea[]
  tenant         Tenant                   @relation(fields: [tenantId], references: [id])
  createdAt      DateTime                 @default(now())

  @@map("cliente_devoluciones")
}

model ClienteDevolucionLinea {
  id             String            @id @default(uuid())
  devolucionId   String
  productId      String
  tallaId        String
  cantidad       Int
  precioUnitario Decimal           @db.Decimal(10, 2)
  subtotal       Decimal           @db.Decimal(10, 2)
  devolucion     ClienteDevolucion @relation(fields: [devolucionId], references: [id], onDelete: Cascade)

  @@map("cliente_devolucion_lineas")
}

model ProveedorDevolucion {
  id             String                    @id @default(uuid())
  tenantId       String
  entradaId      String?
  supplierId     String
  motivo         String
  totalDevuelto  Decimal                   @db.Decimal(10, 2)
  estado         String                    @default("COMPLETADO") // COMPLETADO | RECHAZADO
  lines          ProveedorDevolucionLinea[]
  tenant         Tenant                    @relation(fields: [tenantId], references: [id])
  createdAt      DateTime                  @default(now())

  @@map("proveedor_devoluciones")
}

model ProveedorDevolucionLinea {
  id             String              @id @default(uuid())
  devolucionId   String
  productId      String
  tallaId        String
  cantidad       Int
  precioCosto    Decimal             @db.Decimal(10, 2)
  subtotal       Decimal             @db.Decimal(10, 2)
  devolucion     ProveedorDevolucion @relation(fields: [devolucionId], references: [id], onDelete: Cascade)

  @@map("proveedor_devolucion_lineas")
}

// ──────────────────────────────────────────
// FASE 12 — FACTURACIÓN ELECTRÓNICA SRI
// ──────────────────────────────────────────

model FacturaElectronica {
  id                String   @id @default(uuid())
  tenantId          String
  saleNoteId        String?  @unique
  claveAcceso       String?  @unique
  numeroComprobante String   // 001-001-000000001
  estadoSri         String   @default("PENDIENTE") // PENDIENTE | AUTORIZADO | RECHAZADO | DEVUELTA
  xmlUrl            String?
  ridePdfUrl        String?
  errorMensaje      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id])

  @@map("facturas_electronicas")
}

// ──────────────────────────────────────────
// FASE 14 — POS MOSTRADOR Y CIERRE DE CAJA / PERÍODO
// ──────────────────────────────────────────

model CierreCaja {
  id                   String    @id @default(uuid())
  tenantId             String
  userId               String    // Cajero / Vendedor que realizó el turno
  fechaApertura        DateTime  @default(now())
  fechaCierre          DateTime?
  montoInicial         Decimal   @db.Decimal(10, 2) // Efectivo base en caja al abrir
  ventasEfectivo       Decimal   @default(0) @db.Decimal(10, 2)
  ventasTarjeta        Decimal   @default(0) @db.Decimal(10, 2)
  ventasTransferencia  Decimal   @default(0) @db.Decimal(10, 2)
  totalVentas          Decimal   @default(0) @db.Decimal(10, 2)
  montoEsperadoEfectivo Decimal  @default(0) @db.Decimal(10, 2)
  montoRealEfectivo    Decimal?  @db.Decimal(10, 2) // Ingresado por el usuario en el arqueo
  diferencia           Decimal?  @db.Decimal(10, 2) // Sobrante (+) o Faltante (-)
  estado               String    @default("ABIERTA") // ABIERTA | CERRADA
  notas                String?

  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("cierres_caja")
}




