// ══════════════════════════════════════════
// NEXORA — Schema Prisma
// Fase 1: Fundación e Infraestructura Base
// ══════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────

enum Rol {
  ROL_ADMIN
  ROL_VENDEDOR
  ROL_BODEGUERO
}

enum SeasonTipo {
  INICIO_CLASES
  NAVIDAD
  FIESTAS_LOCALES
  OTRA
}

// ──────────────────────────────────────────
// AUTH — Usuarios y Tokens
// ──────────────────────────────────────────

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  nombre         String
  rol            Rol
  activo         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ──────────────────────────────────────────
// CONFIGURACIÓN DEL NEGOCIO
// ──────────────────────────────────────────

model BusinessConfig {
  id        String   @id @default(uuid())
  nombre    String
  ruc       String   // Cifrado con AES-256-GCM en capa de infraestructura
  direccion String
  telefono  String?
  email     String?
  logoUrl   String?
  updatedAt DateTime @updatedAt

  @@map("business_config")
}

// ──────────────────────────────────────────
// TEMPORADAS
// ──────────────────────────────────────────

model Season {
  id          String     @id @default(uuid())
  nombre      String
  tipo        SeasonTipo
  fechaInicio DateTime
  fechaFin    DateTime
  activa      Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@map("seasons")
}

// ──────────────────────────────────────────
// SERIES Y TALLAS DE CALZADO
// ──────────────────────────────────────────

model SeriesConfig {
  id       String        @id @default(uuid())
  nombre   String        @unique // BEBE, NINO_PEQUENO_A, NINO_PEQUENO_B, NINO, JUVENIL, ADULTO, TALLA_GRANDE
  activa   Boolean       @default(true)
  tallas   TallaConfig[]
  products Product[]

  @@map("series_config")
}

model TallaConfig {
  id           String         @id @default(uuid())
  numero       Int
  serieId      String
  serie        SeriesConfig   @relation(fields: [serieId], references: [id], onDelete: Cascade)
  stockByTalla StockByTalla[]

  @@map("talla_config")
}

// ──────────────────────────────────────────
// INVENTARIO — Productos y Stock (Fase 2)
// ──────────────────────────────────────────

model Product {
  id                String             @id @default(uuid())
  codigo            String             @unique
  nombre            String
  marca             String
  modelo            String
  material          String?
  fotoUrl           String?
  precioCosto       Decimal            @db.Decimal(10, 2)
  precioVenta       Decimal            @db.Decimal(10, 2)
  serieId           String
  serie             SeriesConfig       @relation(fields: [serieId], references: [id])
  activo            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  stockByTalla      StockByTalla[]
  stockReservations StockReservation[]
  stockMovements    StockMovement[]
  priceHistory      PriceHistory[]

  @@map("products")
}

model StockByTalla {
  id                String      @id @default(uuid())
  productId         String
  tallaId           String
  cantidad          Int         @default(0) // stock físico real
  cantidadReservada Int         @default(0) // suma de reservas activas
  stockMinimo       Int         @default(0)
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  talla             TallaConfig @relation(fields: [tallaId], references: [id], onDelete: Cascade)

  @@unique([productId, tallaId])
  @@map("stock_by_talla")
}

model StockReservation {
  id          String   @id @default(uuid())
  productId   String
  tallaId     String
  cantidad    Int
  motivo      String   // "PEDIDO", "MUESTRA", "ANTICIPO"
  referenceId String?  // ID de referencia (pedidoId, etc.)
  expiresAt   DateTime
  cancelada   Boolean  @default(false)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_reservations")
}

model StockMovement {
  id          String         @id @default(uuid())
  productId   String
  tallaId     String
  tipo        MovimientoTipo
  cantidad    Int            // Positivo = entrada, Negativo = salida
  motivo      String
  referenceId String?
  userId      String
  createdAt   DateTime       @default(now())
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}

enum MovimientoTipo {
  ENTRADA_MERCANCIA
  VENTA
  DEVOLUCION_CLIENTE
  DEVOLUCION_PROVEEDOR
  BAJA
  AJUSTE
  RESERVA
  LIBERACION_RESERVA
}

model PriceHistory {
  id                  String   @id @default(uuid())
  productId           String
  precioCostoAnterior Decimal  @db.Decimal(10, 2)
  precioVentaAnterior Decimal  @db.Decimal(10, 2)
  precioCostoNuevo    Decimal  @db.Decimal(10, 2)
  precioVentaNuevo    Decimal  @db.Decimal(10, 2)
  cambiadoPorId       String
  motivo              String?
  createdAt           DateTime @default(now())
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("price_history")
}

// ──────────────────────────────────────────
// CLIENTES Y SCORING CREDITICIO (Fase 3)
// ──────────────────────────────────────────

enum NivelCredito {
  SIN_CREDITO
  NIVEL_1
  NIVEL_2
  NIVEL_3
  NIVEL_4
}

model Client {
  id                 String               @id @default(uuid())
  nombre             String
  apellido           String
  telefono           String
  email              String?
  ruc                String?              // Cifrado con AES-256-GCM
  cedula             String?              // Cifrado con AES-256-GCM
  direccion          String?
  notas              String?
  nivelCredito       NivelCredito         @default(SIN_CREDITO)
  totalCompras       Int                  @default(0)  // Contador de compras de contado + crédito completadas
  comprasSinAtraso   Int                  @default(0)  // Racha actual de pagos a tiempo
  atrasoConsecutivo  Int                  @default(0)  // Atrasos consecutivos sin saldar
  limiteCredito      Decimal              @db.Decimal(10, 2) @default(0)
  creditoUtilizado   Decimal              @db.Decimal(10, 2) @default(0)
  activo             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  creditScoreHistory CreditScoreHistory[]

  @@map("clients")
}

model CreditScoreHistory {
  id            String       @id @default(uuid())
  clientId      String
  nivelAnterior NivelCredito
  nivelNuevo    NivelCredito
  motivo        String       // "COMPRA_COMPLETADA" | "ATRASO" | "AJUSTE_MANUAL" | "DOS_ATRASOS_CONSECUTIVOS"
  ajustadoPorId String?      // ID del administrador si es AJUSTE_MANUAL
  createdAt     DateTime     @default(now())
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("credit_score_history")
}

model CreditLevelConfig {
  id                String       @id @default(uuid())
  nivel             NivelCredito @unique
  comprasRequeridas Int
  limiteDolares     Decimal      @db.Decimal(10, 2)
  plazoDias         Int
  updatedAt         DateTime     @updatedAt

  @@map("credit_level_config")
}

// ──────────────────────────────────────────
// COMERCIAL — Pedidos y Cola de Prioridad (Fase 4A)
// ──────────────────────────────────────────

enum EstadoPedido {
  EN_ESPERA_STOCK
  PENDIENTE
  EN_PREPARACION
  EN_TRANSITO
  MODIFICADO
  CANCELADO
  ENTREGADO
}

enum CanalEntrada {
  MANUAL
  WHATSAPP
  CATALOGO
}

enum TipoPago {
  CONTADO
  CREDITO
}

enum TipoVenta {
  SERIE_COMPLETA
  TALLA_ESPECIFICA
}

model Order {
  id            String         @id @default(uuid())
  clientId      String
  estado        EstadoPedido   @default(PENDIENTE)
  canal         CanalEntrada
  tipoPago      TipoPago
  montoTotal    Decimal        @db.Decimal(10, 2)
  notas         String?
  userId        String         // quién creó el pedido
  lines         OrderLine[]
  queueEntry    OrderQueue?
  dispatchOrder DispatchOrder?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("orders")
}

model OrderLine {
  id             String    @id @default(uuid())
  orderId        String
  productId      String
  serieId        String
  tallaId        String
  cantidad       Int
  precioUnitario Decimal   @db.Decimal(10, 2)
  tipoVenta      TipoVenta
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_lines")
}

model OrderQueue {
  id             String       @id @default(uuid())
  orderId        String       @unique
  clientId       String
  prioridadFifo  DateTime     // timestamp de creación del pedido original
  nivelCredito   NivelCredito
  totalHistorico Decimal      @db.Decimal(10, 2) // total histórico de compras del cliente
  activa         Boolean      @default(true)
  activadaAt     DateTime?
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@map("order_queues")
}

enum DispatchEstado {
  PENDIENTE_SEPARACION
  SEPARADO
  EN_TRANSITO
}

model DispatchOrder {
  id              String              @id @default(uuid())
  orderId         String              @unique
  estado          DispatchEstado      @default(PENDIENTE_SEPARACION)
  lines           DispatchOrderLine[]
  confirmadoPorId String?
  confirmadoAt    DateTime?
  createdAt       DateTime            @default(now())
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("dispatch_orders")
}

model DispatchOrderLine {
  id         String        @id @default(uuid())
  dispatchId String
  productId  String
  serieId    String
  tallaId    String
  cantidad   Int
  aceptada   Boolean       @default(true) // false si el cliente rechazó en entrega
  dispatch   DispatchOrder @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@map("dispatch_order_lines")
}

model OrderModification {
  id               String   @id @default(uuid())
  orderId          String
  tipoModificacion String   // "RECHAZO_PARCIAL" | "CANCELACION_TOTAL"
  montoOriginal    Decimal  @db.Decimal(10, 2)
  montoNuevo       Decimal  @db.Decimal(10, 2)
  lineasRechazadas Json     // array de { productId, tallaId, cantidad }
  userId           String
  createdAt        DateTime @default(now())

  @@map("order_modifications")
}




