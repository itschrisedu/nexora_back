# ══════════════════════════════════════════
# NEXORA — Variables de Entorno (ejemplo)
# ══════════════════════════════════════════
# Copiar este archivo como .env y rellenar los valores.

# ── Base de Datos (PostgreSQL — Neon) ──
DATABASE_URL=

# ── JWT ──
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── Cifrado AES-256-GCM ──
AES_MASTER_KEY=

# ── Email (Resend) ──
EMAIL_API_KEY=
EMAIL_FROM=

# ── Frontend ──
FRONTEND_URL=http://localhost:3000

# ── Server ──
PORT=3001
